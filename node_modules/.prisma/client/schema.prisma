// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MissionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum MissionRuleType {
  WIN_EACH_ROLE
  DAILY_CS
  GAMES_VISION_MIN
  GAMES_KP_MIN
  CHAMPION_GAMES_WINS
  DAILY_WARDS_DESTROYED
  WIN_STREAK_NO_DEATH
  GAMES_WIN_STREAK_PENTAKILL
  WIN_STREAK_EACH_ROLE_NO_DEATH
  SINGLE_GAME_HEAL_DAMAGE
  GAMES_DAMAGE_TAKEN_WINS
}

enum UserMissionStatus {
  OFFER
  ACTIVE
  COMPLETED
  EXPIRED
}

enum WpggTransactionType {
  MISSION_REWARD
  REROLL
  ADJUSTMENT
  WITHDRAW_RESERVED
}

model User {
  id                       String                    @id @default(uuid())
  email                    String                    @unique
  passwordHash             String
  timezone                 String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  riotAccount              RiotAccount?
  refreshTokens            RefreshToken[]
  riotSessionExchangeCodes RiotSessionExchangeCode[]
  wpggWallet               WpggWallet?
  missionDays              MissionDay[]
  processedMatches         ProcessedMatch[]
}

model RiotAccount {
  id         String   @id @default(uuid())
  userId     String   @unique
  puuid      String   @unique
  gameName   String
  tagLine    String
  region     String
  summonerId String
  accountId  String
  linkedAt   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RiotSessionExchangeCode {
  id        String    @id @default(uuid())
  codeHash  String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model MissionTemplate {
  id           String            @id @default(uuid())
  difficulty   MissionDifficulty
  ruleType     MissionRuleType
  titleEs      String
  titleEn      String
  targetJson   Json
  rewardWpgg   Int
  sortOrder    Int               @default(0)
  offers       MissionOffer[]
  userMissions UserMission[]

  @@index([difficulty])
}

model MissionDay {
  id           String         @id @default(uuid())
  userId       String
  calendarDate DateTime       @db.Date
  createdAt    DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  offers       MissionOffer[]
  userMissions UserMission[]

  @@unique([userId, calendarDate])
  @@index([userId, calendarDate])
}

model MissionOffer {
  id                  String          @id @default(uuid())
  missionDayId        String
  templateId          String
  slot                Int
  championId          Int?
  rerolledFromOfferId String?
  createdAt           DateTime        @default(now())
  missionDay          MissionDay      @relation(fields: [missionDayId], references: [id], onDelete: Cascade)
  template            MissionTemplate @relation(fields: [templateId], references: [id])
  userMission         UserMission?

  @@unique([missionDayId, slot])
  @@index([missionDayId])
}

model UserMission {
  id              String            @id @default(uuid())
  missionDayId    String
  templateId      String
  offerId         String?           @unique
  status          UserMissionStatus @default(OFFER)
  progressPercent Int               @default(0)
  progressJson    Json              @default("{}")
  acceptedAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  missionDay      MissionDay        @relation(fields: [missionDayId], references: [id], onDelete: Cascade)
  template        MissionTemplate   @relation(fields: [templateId], references: [id])
  offer           MissionOffer?     @relation(fields: [offerId], references: [id])

  @@index([missionDayId, status])
}

model WpggWallet {
  id           String            @id @default(uuid())
  userId       String            @unique
  balance      Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WpggTransaction[]
}

model WpggTransaction {
  id          String              @id @default(uuid())
  walletId    String
  type        WpggTransactionType
  amount      Int
  referenceId String?
  description String
  createdAt   DateTime            @default(now())
  wallet      WpggWallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, referenceId])
  @@index([walletId, createdAt])
}

model ProcessedMatch {
  id        String   @id @default(uuid())
  userId    String
  matchId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([userId])
}

model WpggMarketPrice {
  id       String   @id @default(uuid())
  date     DateTime @unique @db.Date
  priceUsd Decimal  @db.Decimal(12, 6)
}
