// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                    @id @default(uuid())
  email                    String                    @unique
  passwordHash             String
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  riotAccount              RiotAccount?
  refreshTokens            RefreshToken[]
  riotSessionExchangeCodes RiotSessionExchangeCode[]
}

model RiotAccount {
  id         String   @id @default(uuid())
  userId     String   @unique
  puuid      String   @unique
  gameName   String
  tagLine    String
  region     String
  summonerId String
  accountId  String
  linkedAt   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One-time code after Riot OAuth redirect (`riot_session` query param).
model RiotSessionExchangeCode {
  id        String    @id @default(uuid())
  codeHash  String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}
